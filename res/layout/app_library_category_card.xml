<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.applibrary.view.AppCategoryCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="4dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/category_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorPrimary"
        android:lines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/category_card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.android.launcher3.applibrary.view.AppLibraryIconView
                android:id="@+id/card_slot_0"
                style="@style/BaseIcon.AllApps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:padding="0dp"
                launcher:centerVertically="true"
                android:textSize="11sp"
                launcher:iconDisplay="all_apps"
                android:visibility="invisible" />

            <com.android.launcher3.applibrary.view.AppLibraryIconView
                android:id="@+id/card_slot_1"
                style="@style/BaseIcon.AllApps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:padding="0dp"
                launcher:centerVertically="true"
                android:textSize="11sp"
                launcher:iconDisplay="all_apps"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.android.launcher3.applibrary.view.AppLibraryIconView
                android:id="@+id/card_slot_2"
                style="@style/BaseIcon.AllApps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:padding="0dp"
                launcher:centerVertically="true"
                android:textSize="11sp"
                launcher:iconDisplay="all_apps"
                android:visibility="invisible" />

            <FrameLayout
                android:id="@+id/card_slot_3_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <com.android.launcher3.applibrary.view.AppLibraryIconView
                    android:id="@+id/card_slot_3_single"
                    style="@style/BaseIcon.AllApps"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:padding="0dp"
                    launcher:centerVertically="true"
                    android:textSize="11sp"
                    launcher:iconDisplay="all_apps"
                    android:visibility="invisible" />

                <LinearLayout
                    android:id="@+id/card_slot_3_mini_cluster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:padding="2dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/mini_icon_0"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_margin="1dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter" />

                        <ImageView
                            android:id="@+id/mini_icon_1"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_margin="1dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/mini_icon_2"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_margin="1dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter" />

                        <ImageView
                            android:id="@+id/mini_icon_3"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_margin="1dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</com.android.launcher3.applibrary.view.AppCategoryCardView>
